AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-v4-flash

# Backward-compatible fallback. Prefer AI_* for new deployments.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional shared cache/rate limit store for production deployments.
# If unset, the app falls back to per-instance memory cache/rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional token for GET /api/metrics. Leave unset to disable the endpoint.
METRICS_TOKEN=

